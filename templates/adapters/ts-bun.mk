# Stack adapter: TypeScript + Bun (lint and format: Biome; types: tsc)

CMD_SETUP     := bun install
CMD_DEV       := bun run dev
CMD_SEED      := bun run seed
CMD_FMT       := bun run fmt
CMD_FMT_CHECK := bun run fmt:check
CMD_LINT      := bun run lint
CMD_TYPECHECK := bun run typecheck
CMD_TEST      := bun test
