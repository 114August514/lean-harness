# Lean Harness Standard .gitignore

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
credentials.json

# Operating System & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node / TypeScript / Bun
node_modules/
.npm/
.yarn/
dist/
coverage/

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Rust
/target/

# Local Temporary / Scratch
tmp/
temp/
*.log
