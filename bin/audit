#!/usr/bin/env bash
# Scan the current change set for high-risk signals.
#
# Usage: bin/audit [BASE]
#
# BASE defaults to the merge-base with the default branch: a feature branch
# is audited as a whole, the default branch itself only for uncommitted
# changes. An explicit BASE must exist in this clone.
#
# Exit status: 0 = no critical finding (warnings allowed), 1 = a critical
# boundary was touched and needs deliberate review, 2 = usage error.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT_DIR"

default_base() {
    local candidate
    if ! git rev-parse --verify --quiet HEAD >/dev/null; then
        git hash-object -t tree /dev/null # no commits yet: everything is new
        return
    fi
    for candidate in "$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)" origin/main main; do
        if [ -n "$candidate" ] && git rev-parse --verify --quiet "${candidate}^{commit}" >/dev/null; then
            git merge-base HEAD "$candidate"
            return
        fi
    done
    git rev-parse HEAD
}

if [ -n "${1:-}" ]; then
    base="$1"
    if ! git rev-parse --verify --quiet "${base}^{commit}" >/dev/null; then
        echo "error: base '$base' is not a commit in this clone (shallow clone? fetch full history)" >&2
        exit 2
    fi
else
    base="$(default_base)"
fi

echo "=== Lean Harness Change Audit ==="
echo "Base: $base"

changed="$({
    git diff --name-only "$base"
    git ls-files --others --exclude-standard
} | sort -u)"
if [ -z "$changed" ]; then
    echo "No changes against the base."
    exit 0
fi
echo "Changed files: $(printf '%s\n' "$changed" | wc -l | tr -d ' ')"

critical=0
warnings=0

show() {
    printf '%s\n' "$1" | sed -n '1,10s/^/    /p'
}

echo ""
echo "--- Boundaries ---"
boundary="$(printf '%s\n' "$changed" | grep -E '(^|/)migrations/|^(contracts|api|schema)/' || true)"
if [ -n "$boundary" ]; then
    echo "  [CRITICAL] migration or contract paths changed; review compatibility and rollback:"
    show "$boundary"
    critical=$((critical + 1))
else
    echo "  [PASS] no migration or contract paths"
fi

deps="$(printf '%s\n' "$changed" | grep -E '(^|/)(package\.json|package-lock\.json|bun\.lockb?|pnpm-lock\.yaml|yarn\.lock|pyproject\.toml|uv\.lock|requirements[^/]*\.txt|Cargo\.(toml|lock)|go\.(mod|sum))$' || true)"
if [ -n "$deps" ]; then
    echo "  [WARN] dependency manifests changed; check every new dependency is needed:"
    show "$deps"
    warnings=$((warnings + 1))
else
    echo "  [PASS] no dependency manifests"
fi

echo ""
echo "--- Secrets ---"
secrets="$(printf '%s\n' "$changed" |
    grep -E '(^|/)(\.env(\.[^/]+)?|id_(rsa|ecdsa|ed25519)[^/]*|credentials\.json)$|\.(pem|key|p12|pfx)$' |
    grep -vE '\.(example|sample|template)$' || true)"
if [ -n "$secrets" ]; then
    echo "  [CRITICAL] possible secret or key files:"
    show "$secrets"
    critical=$((critical + 1))
else
    echo "  [PASS] no secret-like files"
fi

echo ""
echo "--- Tests ---"
test_diff="$(git diff "$base" -- '*test*')"
removed="$(printf '%s\n' "$test_diff" | grep -E '^-' | grep -vE '^---' | grep -E 'assert|expect' || true)"
if [ -n "$removed" ]; then
    echo "  [WARN] test assertions removed or changed:"
    show "$removed"
    warnings=$((warnings + 1))
fi
skipped="$(printf '%s\n' "$test_diff" | grep -E '^\+' | grep -vE '^\+\+\+' |
    grep -E '@pytest\.mark\.(skip|xfail)|\.skip\(|(^|[^[:alnum:]_])xit\(|@Ignore|t\.Skip|#\[ignore\]' || true)"
if [ -n "$skipped" ]; then
    echo "  [WARN] skipped tests added:"
    show "$skipped"
    warnings=$((warnings + 1))
fi
swallowed="$(git diff "$base" |
    grep -E -A1 '^\+.*(except[^:]*:|catch[[:space:]]*(\([^)]*\))?[[:space:]]*\{)[[:space:]]*$' |
    grep -E '^\+[[:space:]]*(pass|return|continue|//.*|\})[[:space:]]*$' || true)"
if [ -n "$swallowed" ]; then
    echo "  [WARN] possibly swallowed exceptions:"
    show "$swallowed"
    warnings=$((warnings + 1))
fi
if [ -z "$removed$skipped$swallowed" ]; then
    echo "  [PASS] no removed assertions, new skips or empty handlers"
fi

echo "-----------------------------------"
if [ "$critical" -gt 0 ]; then
    echo "Audit: ATTENTION NEEDED ($critical critical, $warnings warnings)"
    exit 1
fi
echo "Audit: PASS ($warnings warnings)"
