#!/usr/bin/env bash
# Check the repository baseline: Git state, required tools, standard verbs
# and the Lean Harness binding. Exits 1 when something required is missing.
# Works both in the Lean Harness repository and in scaffolded projects.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT_DIR"

errors=0
warnings=0

pass() { echo "  [PASS] $1"; }
warn() {
    echo "  [WARN] $1"
    warnings=$((warnings + 1))
}
fail() {
    echo "  [FAIL] $1"
    errors=$((errors + 1))
}
require_tool() {
    if command -v "$1" >/dev/null 2>&1; then
        pass "$1 available"
    else
        fail "$1 not found on PATH"
    fi
}

harness_repo=false
[ -f continuity/contract.md ] && harness_repo=true

echo "=== Lean Harness Doctor ==="

echo "Git:"
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    pass "inside a Git repository (branch: $(git branch --show-current))"
    if [ -z "$(git status --porcelain)" ]; then
        pass "working tree clean"
    else
        warn "working tree has uncommitted changes"
    fi
else
    fail "not inside a Git repository"
fi

echo "Tools:"
require_tool git
require_tool make
if [ "$harness_repo" = true ]; then
    require_tool uv
elif [ -f stack.mk ]; then
    # Every program the stack adapter invokes must be installed.
    for tool in $(sed -n 's/^CMD_[A-Z_]*[[:space:]]*:=[[:space:]]*\([^[:space:]]*\).*/\1/p' stack.mk | sort -u); do
        require_tool "$tool"
    done
fi
if command -v omp >/dev/null 2>&1; then
    pass "omp available"
else
    warn "omp not on PATH (only needed for the OMP runtime)"
fi

echo "Standard verbs:"
if [ -f Makefile ]; then
    for verb in check test; do
        if grep -q "^${verb}:" Makefile; then
            pass "make $verb defined"
        else
            fail "make $verb missing"
        fi
    done
else
    fail "Makefile missing"
fi

echo "Harness:"
if [ "$harness_repo" = true ]; then
    if [ -f policy/index.md ]; then pass "policy/index.md present"; else fail "policy/index.md missing"; fi
    if [ -d skills/_shared ]; then pass "skills present"; else fail "skills/_shared missing"; fi
else
    if [ -f stack.mk ]; then pass "stack.mk present"; else warn "stack.mk missing (no stack adapter)"; fi
    if [ -d .omp ] || [ -f CLAUDE.md ]; then
        pass "Lean Harness binding present"
    else
        warn "no Lean Harness binding (.omp/ or CLAUDE.md); run bind-project.sh"
    fi
fi

echo "-----------------------------------"
if [ "$errors" -eq 0 ]; then
    echo "Doctor: HEALTHY ($warnings warnings)"
else
    echo "Doctor: UNHEALTHY ($errors errors, $warnings warnings)"
    exit 1
fi
